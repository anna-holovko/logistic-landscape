# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Never commit .env.local to git - it contains secrets

# ===== Application Configuration =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# ===== Database Configuration =====
# Optional: Set the SQLite database path
# Default: project-relative (./newsletter.db)
# For production external server: /var/lib/logistic-landscape/data/newsletter.db
# DATABASE_PATH=/var/lib/logistic-landscape/data/newsletter.db
