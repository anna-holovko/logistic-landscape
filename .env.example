# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Never commit .env.local to git - it contains secrets

# ===== Site Configuration =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ===== Supabase Configuration =====
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server-side only secrets (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ===== Database Configuration =====
# PostgreSQL connection strings
POSTGRES_URL=your_postgres_url_here
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling_here
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=your_postgres_host_here
POSTGRES_DATABASE=your_postgres_database_here

# ===== Vercel Configuration =====
# Only needed in Vercel deployments
VERCEL_ENV=production
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here
